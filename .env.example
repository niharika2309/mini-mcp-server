# Copy this file to .env and fill in your values:  cp .env.example .env
# The .env file is git-ignored - never commit real secrets.

# REQUIRED for publishing/checking files on GitHub.
# Create a token at https://github.com/settings/tokens
GITHUB_TOKEN=

# OPTIONAL overrides - the defaults below already match the curriculum repo.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=

# ---------------------------------------------------------------------------
# AI AGENT (agent/ - only needed for `python -m agent`)
# Copy the lines you use; everything has sensible defaults. See README.
# ---------------------------------------------------------------------------
# openai | anthropic | mock  (mock = offline scripted demo, no key needed)
#LLM_PROVIDER=openai
#LLM_MODEL=gpt-4o-mini
#LLM_API_KEY=
#LLM_BASE_URL=https://api.openai.com/v1   # point at OpenRouter/Ollama/LM Studio etc.

# Agent limits and safety
#AGENT_MAX_STEPS=10
#AGENT_APPROVAL_TOOLS=publish_article_to_github
