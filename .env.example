# Copy this file to .env and fill in your values:  cp .env.example .env
# The .env file is git-ignored - never commit real secrets.

# REQUIRED for publishing/checking files on GitHub.
# Create a token at https://github.com/settings/tokens
#   - Fine-grained token: repository access -> niharika2309/16-week-ai-ml-series
#     with permission "Contents: Read and write".
#   - (A classic token with the "repo" scope also works.)
GITHUB_TOKEN=

# OPTIONAL overrides - the defaults below already match the curriculum repo.
GITHUB_OWNER=niharika2309
GITHUB_REPO=16-week-ai-ml-series
GITHUB_DEFAULT_BRANCH=main
